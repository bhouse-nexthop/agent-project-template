#!/usr/bin/env bash
# <name>: <one line on what it does>.
# Usage: <name> [--dry-run] <args>
# Prints PASS/FAIL per check and a SUMMARY line; exits non-zero on any failure.
set -u

dry_run=0
if [[ ${1:-} == --dry-run ]]; then
  dry_run=1
  shift
fi

fails=0
checks=0

check() {
  # check "<description>" <command...>
  local desc=$1
  shift
  checks=$((checks + 1))
  if "$@"; then
    echo "PASS $desc"
  else
    echo "FAIL $desc"
    fails=$((fails + 1))
  fi
}

run() {
  # Runs a state-changing command, or prints it under --dry-run.
  if ((dry_run)); then
    echo "DRY-RUN $*"
  else
    "$@"
  fi
}

# check "target reachable" ping -c1 -W2 <host>
# run <state-changing command>

if ((fails)); then
  echo "SUMMARY FAIL $fails of $checks checks failed"
  exit 1
fi
echo "SUMMARY PASS $checks checks"
